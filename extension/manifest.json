{
  "manifest_version": 3,
  "name": "Wishlist",
  "version": "1.0.0",
  "description": "Scan the product page you're on and add it to your Wishlist app.",
  "action": {
    "default_title": "Add this product to your Wishlist",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
